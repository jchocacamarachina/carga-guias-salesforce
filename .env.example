# Copiar a .env (o cargar en el panel de variables de entorno del hosting).
# .env está en .gitignore: NUNCA commitear las credenciales reales.

# ---------- Salesforce (obligatorio) ----------
SF_USER=usuario@empresa.com
SF_PASS=
SF_SECURITY_TOKEN=

# ---------- Integraciones (obligatorio) ----------
# imgbb genera las URLs públicas que se mandan al cliente por WhatsApp.
# Sin esta key la entrega falla: no habría links para guardar en Salesforce.
IMGBB_API_KEY=
# Webhook de Make que dispara el mensaje al cliente.
MAKE_WEBHOOK_URL=

# ---------- Accesos de administración (obligatorio) ----------
# ADMIN_TOKEN: panel de diagnóstico /admin/logs y /admin/status.
#   Uso: https://tu-app/admin/logs?token=EL_TOKEN
ADMIN_TOKEN=
# ADMIN_KEY: habilita los botones de admin del supervisor y el borrado de historial.
#   Uso: https://tu-app/historial/LA_CLAVE  y  https://tu-app/registro/LA_CLAVE
#   Antes esto estaba hardcodeado como "admin1" en el código fuente. Si no la definís,
#   los botones de borrado quedan deshabilitados y el endpoint responde 403.
ADMIN_KEY=

# ---------- Almacenamiento ----------
# Ruta del SQLite con el historial de entregas.
# OJO en Render/Railway: si no apunta a un disco persistente, el historial se borra
# en cada deploy. Con disco montado en /data usar: DB_PATH=/data/entregas.db
DB_PATH=./entregas.db

# ---------- Alertas (muy recomendado) ----------
# A dónde avisar cuando el servicio se rompe. Recibe un POST con JSON:
#   { "app", "clave", "titulo", "detalle", "timestamp" }
# Sirve cualquier cosa que acepte un webhook: un segundo escenario de Make que mande
# WhatsApp o mail, un bot de Telegram, Slack, Discord, n8n.
# Si queda vacío, los problemas se siguen registrando en los logs pero NADIE se entera.
ALERT_WEBHOOK_URL=
# Minutos de silencio por cada tipo de problema, para que una caída durante una ruta
# de 30 entregas no dispare 30 mensajes.
ALERT_COOLDOWN_MIN=30
# Minutos sin ninguna entrega tras los cuales /health se declara enfermo.
# 0 = desactivado (default). Activalo solo si conocés tu ritmo real de entregas:
# en un día flojo pueden pasar horas sin entregas y no significa que algo esté roto.
ALERTA_SIN_ENTREGAS_MIN=0

# ---------- Ajustes opcionales ----------
# Límite total por subida (todas las fotos juntas). Con compresión previa una foto
# pesa ~300 KB, así que 40 MB da margen de sobra.
MAX_UPLOAD_MB=40
# Segundos tras los cuales un job que quedó "processing" se considera abandonado
# (worker muerto por timeout o deploy) y se libera para reintento.
# Tiene que ser MAYOR que el --timeout de gunicorn (si no, se cancelarían jobs que
# todavía están trabajando) pero no mucho más: mientras el job está trabado, el celular
# del repartidor recibe 409 en cada reintento. Con --timeout 180, un buen valor es 300.
JOB_STALE_SECS=300
# Puerto local (solo para `python main.py`).
PORT=5000
# Debug de Flask. Dejar en 0 en producción.
FLASK_DEBUG=0
